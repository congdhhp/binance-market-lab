# Django settings
SECRET_KEY=django-insecure-change-this-in-production-f8k3h4k2j3h4k2j3h4k2j3h4k2j3h4k2
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL + TimescaleDB)
DB_NAME=binance_market_lab
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/1

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Binance API (READ-ONLY keys recommended)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=False

# CORS (React frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM APIs (optional for Phase 7-8)
OPENAI_API_KEY=your_openai_api_key_here

# CryptoPanic News API (optional for Phase 7)
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here

# Telegram Bot (optional for alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Sentry (optional for error tracking in production)
SENTRY_DSN=your_sentry_dsn_here
